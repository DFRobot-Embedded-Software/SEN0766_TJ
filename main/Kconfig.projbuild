#
# mcp_sensors 板级配置
#
# 总线一览（改引脚前先看这里，避免冲突）：
#
#   I2C0  ── STCC4(0x64) + LTR-303(0x29) + SC7A20H(0x18/0x19)
#   I2C1  ── ES7210 ADC(0x40)
#   I2S0  ── ES7210 录音 RX（BCLK/WS/DIN/MCLK）
#   I2S1  ── NS4168 功放 TX（BCLK/WS/DOUT）
#   UART1 ── C4004 毫米波
#   RMT   ── WS2812
#

menu "1. 板级总线与传感器"

    comment "I2C0：环境传感器共用总线（STCC4 / LTR-303 / SC7A20H）"

    config SENSOR_I2C0_SDA
        int "I2C0 SDA GPIO"
        default 1
        range 0 54
        help
            STCC4、LTR-303、SC7A20H 共用。当前板默认 GPIO1。

    config SENSOR_I2C0_SCL
        int "I2C0 SCL GPIO"
        default 0
        range 0 54
        help
            当前板默认 GPIO0。

    menu "STCC4 CO2 / 温湿度"
        config STCC4_I2C_ADDR
            hex "I2C 7-bit 地址"
            default 0x64
            help
                DFRobot STCC4 默认 0x64，跳线可改为 0x65。

        config STCC4_POLL_INTERVAL_MS
            int "采样间隔 (ms)"
            default 1000
            range 500 60000
    endmenu

    menu "LTR-303ALS-01 环境光"
        config LTR303_ENABLE
            bool "启用"
            default y
            help
                地址固定 0x29，挂在 I2C0。

        config LTR303_POLL_INTERVAL_MS
            int "采样间隔 (ms)"
            depends on LTR303_ENABLE
            default 1000
            range 200 60000
    endmenu

    menu "SC7A20H 加速度计"
        config SC7A20H_ENABLE
            bool "启用"
            default y
            help
                LIS2DH 兼容；WHO_AM_I=0x11。挂在 I2C0。

        config SC7A20H_I2C_ADDR
            hex "首选 I2C 7-bit 地址"
            depends on SC7A20H_ENABLE
            default 0x19
            help
                SA0=1 → 0x19；探测失败再试 0x18。

        config SC7A20H_POLL_INTERVAL_MS
            int "采样间隔 (ms)"
            depends on SC7A20H_ENABLE
            default 200
            range 50 60000
    endmenu

    menu "C4004 毫米波雷达 (UART)"
        config C4004_UART_PORT
            int "UART 端口号"
            default 1
            range 0 2

        config C4004_UART_TX
            int "TX GPIO（接模块 RX）"
            default 50

        config C4004_UART_RX
            int "RX GPIO（接模块 TX）"
            default 51

        config C4004_UART_BAUD
            int "波特率"
            default 115200

        config C4004_AUTO_RECOVER_ENABLE
            bool "启用自动恢复"
            default y

        config C4004_AUTO_RECOVER_INTERVAL_MS
            int "定期 re-sync 间隔 (ms)"
            depends on C4004_AUTO_RECOVER_ENABLE
            default 21600000
            range 300000 86400000

        config C4004_GHOST_RECOVER_COOLDOWN_MS
            int "假目标恢复冷却 (ms)"
            depends on C4004_AUTO_RECOVER_ENABLE
            default 60000
            range 10000 600000
    endmenu

    menu "WS2812 彩灯"
        config WS2812_ENABLE
            bool "启用"
            default y

        config WS2812_GPIO
            int "数据线 GPIO"
            depends on WS2812_ENABLE
            default 21
            range 0 54

        config WS2812_LED_COUNT
            int "灯珠数量"
            depends on WS2812_ENABLE
            default 7
            range 1 64
    endmenu

endmenu

menu "2. 音频硬件 (ES7210 / NS4168)"

    comment "录音 I2S0 + I2C1；播放 I2S1。勿与传感器 I2C0 混用。"

    choice AUDIO_SOURCE
        prompt "麦克风输入"
        default AUDIO_SOURCE_ES7210
        help
            由 audio_capture 打开硬件；YAMNet / esp-sr / 透传只订阅 PCM。

        config AUDIO_SOURCE_ES7210
            bool "ES7210 ADC"
        config AUDIO_SOURCE_FAKE
            bool "Fake 噪声（无硬件）"
    endchoice

    menu "ES7210 麦克风 (I2C1 + I2S0 RX)"
        depends on AUDIO_SOURCE_ES7210

        config ES7210_I2C_PORT
            int "I2C 控制器"
            default 1
            range 0 1
            help
                传感器占 I2C0，ES7210 默认 I2C1。

        config ES7210_I2C_SDA
            int "I2C SDA GPIO"
            default 7

        config ES7210_I2C_SCL
            int "I2C SCL GPIO"
            default 8

        config ES7210_I2C_ADDR
            hex "I2C 7-bit 地址"
            default 0x40
            help
                AD0 接地多为 0x40（codec 侧 8-bit 0x80）。

        config ES7210_MIC_COUNT
            int "麦克风路数"
            default 2
            range 1 2
            help
                1=MIC1 mono；2=MIC1+MIC2 立体声后下混 mono。

        config ES7210_MIC_GAIN_DB
            int "硬件增益 (dB)"
            default 30
            range 0 37

        config ES7210_I2S_BCLK
            int "I2S0 BCLK GPIO"
            default 29

        config ES7210_I2S_WS
            int "I2S0 WS/LRCK GPIO"
            default 27

        config ES7210_I2S_DIN
            int "I2S0 DIN GPIO（codec→ESP）"
            default 28

        config ES7210_I2S_USE_MCLK
            bool "输出 MCLK"
            default y

        config ES7210_I2S_MCLK
            int "I2S0 MCLK GPIO"
            depends on ES7210_I2S_USE_MCLK
            default 30
    endmenu

    menu "NS4168 功放 (I2S1 TX)"
        config NS4168_ENABLE
            bool "启用"
            default y

        config NS4168_I2S_PORT
            int "I2S 控制器"
            depends on NS4168_ENABLE
            default 1
            range 0 2
            help
                与 ES7210 的 I2S0 错开，默认 I2S1。

        config NS4168_I2S_BCLK
            int "BCLK GPIO"
            depends on NS4168_ENABLE
            default 33

        config NS4168_I2S_WS
            int "WS/LRCK GPIO"
            depends on NS4168_ENABLE
            default 32

        config NS4168_I2S_DOUT
            int "DOUT GPIO（ESP→NS4168 DIN）"
            depends on NS4168_ENABLE
            default 26

        config NS4168_SAMPLE_RATE
            int "采样率 (Hz)"
            depends on NS4168_ENABLE
            default 16000
            range 8000 48000
    endmenu

    config AUDIO_CAPTURE_DIGITAL_GAIN
        int "采集数字增益倍数"
        default 4
        range 1 16
        help
            audio_capture 读出 PCM 后、扇出前对 int16 放大并饱和。
            与 ES7210 硬件增益叠加。

endmenu

menu "3. 音频算法 (YAMNet / 唤醒 / 透传)"

    config YAMNET_ENABLE
        bool "启用 YAMNet 声音分类"
        default n
        help
            订阅 audio_capture；模型见 models/yamnet/。

    config YAMNET_VERIFY_ONLY
        bool "仅验证 YAMNet（关 WiFi/传感器/MCP/Web）"
        depends on YAMNET_ENABLE
        default n

    config YAMNET_INFER_MIN_INTERVAL_MS
        int "推理最小间隔 (ms)"
        depends on YAMNET_ENABLE
        range 200 10000
        default 500

    config YAMNET_INFER_HOP_FRAMES
        int "相邻 patch 间隔帧 (10ms/帧)"
        depends on YAMNET_ENABLE
        range 48 96
        default 48

    config YAMNET_INFER_RMS_MIN
        int "静音门限 pcm_rms（0=关闭）"
        depends on YAMNET_ENABLE
        range 0 10000
        default 150

    config YAMNET_EVENT_VOTE_WINDOW
        int "事件投票窗口 N"
        depends on YAMNET_ENABLE
        range 1 16
        default 5

    config YAMNET_EVENT_VOTE_NEED
        int "事件投票最少命中"
        depends on YAMNET_ENABLE
        range 1 16
        default 3

    config YAMNET_EVENT_HOLD_MS
        int "事件告警冷却 (ms)"
        depends on YAMNET_ENABLE
        range 500 60000
        default 4000

    config YAMNET_LOG_VERBOSE
        bool "每次推理打印完整 Top-3"
        depends on YAMNET_ENABLE
        default n

    config YAMNET_INFER_TASK_CORE
        int "推理任务绑核 (-1=不绑)"
        depends on YAMNET_ENABLE
        range -1 1
        default -1

    config YAMNET_DISABLE_ESP_NN
        bool "强制 TFLite reference（仅调试）"
        depends on YAMNET_ENABLE
        default n

    menu "ESP-SR 语音唤醒"
        config ESP_SR_WAKE_ENABLE
            bool "启用"
            depends on YAMNET_ENABLE
            default n
            help
                另在 Component config → ESP Speech Recognition 勾选 WakeNet。

        config ESP_SR_WAKE_START_STREAM
            bool "唤醒后自动 UDP 透传"
            depends on ESP_SR_WAKE_ENABLE && AUDIO_STREAM_ENABLE
            default y

        config ESP_SR_WAKE_FETCH_CORE
            int "AFE fetch 绑核 (-1=不绑)"
            depends on ESP_SR_WAKE_ENABLE
            range -1 1
            default 1
    endmenu

    menu "UDP PCM 透传"
        config AUDIO_STREAM_ENABLE
            bool "启用"
            depends on YAMNET_ENABLE
            default n

        config AUDIO_STREAM_UDP_HOST
            string "目标主机"
            depends on AUDIO_STREAM_ENABLE
            default "192.168.1.100"

        config AUDIO_STREAM_UDP_PORT
            int "目标端口"
            depends on AUDIO_STREAM_ENABLE
            default 9000
            range 1 65535

        config AUDIO_STREAM_MAX_MS
            int "单次最长时长 (ms)"
            depends on AUDIO_STREAM_ENABLE
            default 15000
            range 1000 120000
    endmenu

endmenu

menu "4. MCP 雷达事件"

    config MCP_RADAR_POLL_INTERVAL_MS
        int "事件检测轮询 (ms)"
        default 500
        range 200 5000

    config MCP_RADAR_DWELL_MS
        int "停留告警时长 (ms)"
        default 30000
        range 5000 300000

    config MCP_RADAR_OCC_DEBOUNCE_MS
        int "进出防抖 (ms)"
        default 1500
        range 500 10000

    config MCP_RADAR_CROSSING_COOLDOWN_MS
        int "room_empty 后抑制重复离开 (ms)"
        default 3000
        range 1000 30000

    config MCP_EVENT_LOG_SIZE
        int "事件环形缓冲条数"
        default 32
        range 8 128

endmenu
