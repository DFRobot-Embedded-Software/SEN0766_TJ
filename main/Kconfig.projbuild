#
# mcp_sensors 板级配置
#
# 总线一览（改引脚前先看这里，避免冲突）：
#
#   I2C0  ── STCC4(0x64) + LTR-303(0x29) + SC7A20H(0x18/0x19)
#   I2C1  ── ES7210 ADC(0x40)
#   I2S0  ── ES7210 录音 RX（BCLK/WS/DIN/MCLK）
#   I2S1  ── NS4168 功放 TX（BCLK/WS/DOUT）
#   UART1 ── C4004 毫米波
#   RMT   ── WS2812
#

menu "1. 板级总线与传感器"

    comment "I2C0：环境传感器共用总线（STCC4 / LTR-303 / SC7A20H）"

    config SENSOR_I2C0_SDA
        int "I2C0 SDA GPIO"
        default 1
        range 0 54
        help
            STCC4、LTR-303、SC7A20H 共用。当前板默认 GPIO1。

    config SENSOR_I2C0_SCL
        int "I2C0 SCL GPIO"
        default 0
        range 0 54
        help
            当前板默认 GPIO0。

    menu "STCC4 CO2 / 温湿度"
        config STCC4_I2C_ADDR
            hex "I2C 7-bit 地址"
            default 0x64
            help
                DFRobot STCC4 默认 0x64，跳线可改为 0x65。

        config STCC4_POLL_INTERVAL_MS
            int "采样间隔 (ms)"
            default 1000
            range 500 60000
    endmenu

    menu "LTR-303ALS-01 环境光"
        config LTR303_ENABLE
            bool "启用"
            default y
            help
                地址固定 0x29，挂在 I2C0。

        config LTR303_POLL_INTERVAL_MS
            int "采样间隔 (ms)"
            depends on LTR303_ENABLE
            default 1000
            range 200 60000
    endmenu

    menu "SC7A20H 加速度计"
        config SC7A20H_ENABLE
            bool "启用"
            default y
            help
                LIS2DH 兼容；WHO_AM_I=0x11。挂在 I2C0。

        config SC7A20H_I2C_ADDR
            hex "首选 I2C 7-bit 地址"
            depends on SC7A20H_ENABLE
            default 0x19
            help
                SA0=1 → 0x19；探测失败再试 0x18。

        config SC7A20H_POLL_INTERVAL_MS
            int "采样间隔 (ms)"
            depends on SC7A20H_ENABLE
            default 200
            range 50 60000

        choice SC7A20H_UP_AXIS
            prompt "竖直向上轴（设备立在地面时重力方向）"
            depends on SC7A20H_ENABLE
            default SC7A20H_UP_AXIS_Y
            help
                设备垂直立在地面时，该轴应接近 ±1g。装反时倾角符号会错，可改轴或开“反转前后倾”。

            config SC7A20H_UP_AXIS_X
                bool "X"
            config SC7A20H_UP_AXIS_Y
                bool "Y"
            config SC7A20H_UP_AXIS_Z
                bool "Z"
        endchoice

        choice SC7A20H_FORWARD_AXIS
            prompt "向前倾斜轴（与竖直轴正交）"
            depends on SC7A20H_ENABLE
            default SC7A20H_FORWARD_AXIS_Z
            help
                设备向前倾时，该轴分量增大。须与竖直轴不同。

            config SC7A20H_FORWARD_AXIS_X
                bool "X"
            config SC7A20H_FORWARD_AXIS_Y
                bool "Y"
            config SC7A20H_FORWARD_AXIS_Z
                bool "Z"
        endchoice

        config SC7A20H_INVERT_TILT
            bool "反转前后倾方向"
            depends on SC7A20H_ENABLE
            default n
            help
                若实测向前倾时 C4004 安装角方向反了，打开本项。

        config SC7A20H_UPRIGHT_TOLERANCE_DEG
            int "判定为垂直的容差 (度)"
            depends on SC7A20H_ENABLE
            default 10
            range 1 45
            help
                |前后倾角| 小于该值视为垂直；垂直时向 C4004 下发安装角 0。
    endmenu

    menu "C4004 毫米波雷达 (UART)"
        config C4004_UART_PORT
            int "UART 端口号"
            default 1
            range 0 2

        config C4004_UART_TX
            int "TX GPIO（接模块 RX）"
            default 50

        config C4004_UART_RX
            int "RX GPIO（接模块 TX）"
            default 51

        config C4004_UART_BAUD
            int "波特率"
            default 115200

        config C4004_VERBOSE_LOG
            bool "毫米波详细调试日志 (Debug)"
            default y
            help
                开启后将 c4004 / radar_area / radar_events 设为 Debug，
                输出轨迹查询、目标坐标、人数修正等。调试完可在 menuconfig 关闭。
                需配合 LOG_MAXIMUM_LEVEL >= Debug（工程 defaults 已设置）。

        choice C4004_INSTALL_MODE
            prompt "安装模式"
            default C4004_INSTALL_MODE_SIDE
            help
                对应 DFRobot setInstallInfo：侧装 / 顶装。落地立放一般选侧装。

            config C4004_INSTALL_MODE_SIDE
                bool "侧装 (Side)"
            config C4004_INSTALL_MODE_TOP
                bool "顶装 (Top)"
        endchoice

        config C4004_INSTALL_HEIGHT_CM
            int "安装高度 (cm)"
            default 180
            range 0 65535
            help
                下发给 C4004 的安装高度（网页未配置时的默认值）。侧装时多为雷达距地面高度。
                网页「传感器设置 → 安装高度」保存后会覆盖此值并立即下发。

        choice C4004_TILT_ANGLE_AXIS
            prompt "SC7A20H 前后倾角写入 C4004 的哪个安装角"
            default C4004_TILT_ANGLE_Z
            help
                官方文档强调 Z 轴安装角。加速度前后倾默认写入 zAngle，其余为 0。
                垂直时全部为 0。

            config C4004_TILT_ANGLE_X
                bool "xAngle"
            config C4004_TILT_ANGLE_Y
                bool "yAngle"
            config C4004_TILT_ANGLE_Z
                bool "zAngle"
        endchoice

        choice C4004_RANGE_MODE
            prompt "检测范围模式"
            default C4004_RANGE_MODE_MAX
            help
                当前若用“贴合区域标签”，整体探测框会被缩小到标签外包络，导致可用距离变短。
                推荐“最大四面边界”或“无边界”。

            config C4004_RANGE_MODE_MAX
                bool "最大四面边界（默认，侧装约 4m×7m）"
            config C4004_RANGE_MODE_NO_BOUNDARY
                bool "无边界 (eRangeNoBoundary)"
            config C4004_RANGE_MODE_SIDE_DEFAULT
                bool "侧装默认 (eRangeSideDefault)"
            config C4004_RANGE_MODE_FIT_TAGS
                bool "贴合区域标签外包络（旧行为）"
        endchoice

        config C4004_RANGE_X_CM
            int "最大四面边界：左右半宽 X (cm)"
            depends on C4004_RANGE_MODE_MAX
            default 200
            range 50 2000
            help
                下发 xPositive=+X、xNegative=-X。侧装最大约 ±2m（总宽 4m）。

        config C4004_RANGE_Y_POS_CM
            int "最大四面边界：前方 Y+ (cm)"
            depends on C4004_RANGE_MODE_MAX
            default 700
            range 50 2000
            help
                雷达前方最大探测深度。C4004 侧装最大约 7m。

        config C4004_RANGE_Y_NEG_CM
            int "最大四面边界：后方 Y- (cm，通常 0)"
            depends on C4004_RANGE_MODE_MAX
            default 0
            range -2000 0
            help
                侧装时一般设为 0（雷达背后不检）。

        config C4004_AUTO_RECOVER_ENABLE
            bool "启用自动恢复"
            default y

        config C4004_AUTO_RECOVER_INTERVAL_MS
            int "定期 re-sync 间隔 (ms)"
            depends on C4004_AUTO_RECOVER_ENABLE
            default 21600000
            range 300000 86400000

        config C4004_GHOST_RECOVER_COOLDOWN_MS
            int "假目标恢复冷却 (ms)"
            depends on C4004_AUTO_RECOVER_ENABLE
            default 60000
            range 10000 600000
    endmenu

    menu "WS2812 彩灯"
        config WS2812_ENABLE
            bool "启用"
            default y

        config WS2812_GPIO
            int "数据线 GPIO"
            depends on WS2812_ENABLE
            default 21
            range 0 54

        config WS2812_LED_COUNT
            int "灯珠数量"
            depends on WS2812_ENABLE
            default 7
            range 1 64
    endmenu

endmenu

menu "2. 音频硬件 (ES7210 / NS4168)"

    comment "录音 I2S0 + I2C1；播放 I2S1。勿与传感器 I2C0 混用。"

    choice AUDIO_SOURCE
        prompt "麦克风输入"
        default AUDIO_SOURCE_ES7210
        help
            由 audio_capture 打开硬件；YAMNet / esp-sr / 透传只订阅 PCM。

        config AUDIO_SOURCE_ES7210
            bool "ES7210 ADC"
        config AUDIO_SOURCE_FAKE
            bool "Fake 噪声（无硬件）"
    endchoice

    menu "ES7210 麦克风 (I2C1 + I2S0 RX)"
        depends on AUDIO_SOURCE_ES7210

        config ES7210_I2C_PORT
            int "I2C 控制器"
            default 1
            range 0 1
            help
                传感器占 I2C0，ES7210 默认 I2C1。

        config ES7210_I2C_SDA
            int "I2C SDA GPIO"
            default 7

        config ES7210_I2C_SCL
            int "I2C SCL GPIO"
            default 8

        config ES7210_I2C_ADDR
            hex "I2C 7-bit 地址"
            default 0x40
            help
                AD0 接地多为 0x40（codec 侧 8-bit 0x80）。

        config ES7210_MIC_COUNT
            int "麦克风路数"
            default 2
            range 1 2
            help
                1=MIC1 mono；2=MIC1+MIC2 立体声后下混 mono。

        config ES7210_MIC_GAIN_DB
            int "硬件增益 (dB)"
            default 30
            range 0 37

        config ES7210_I2S_BCLK
            int "I2S0 BCLK GPIO"
            default 29

        config ES7210_I2S_WS
            int "I2S0 WS/LRCK GPIO"
            default 27

        config ES7210_I2S_DIN
            int "I2S0 DIN GPIO（codec→ESP）"
            default 28

        config ES7210_I2S_USE_MCLK
            bool "输出 MCLK"
            default y

        config ES7210_I2S_MCLK
            int "I2S0 MCLK GPIO"
            depends on ES7210_I2S_USE_MCLK
            default 30
    endmenu

    menu "NS4168 功放 (I2S1 TX)"
        config NS4168_ENABLE
            bool "启用"
            default y

        config NS4168_I2S_PORT
            int "I2S 控制器"
            depends on NS4168_ENABLE
            default 1
            range 0 2
            help
                与 ES7210 的 I2S0 错开，默认 I2S1。

        config NS4168_I2S_BCLK
            int "BCLK GPIO"
            depends on NS4168_ENABLE
            default 33

        config NS4168_I2S_WS
            int "WS/LRCK GPIO"
            depends on NS4168_ENABLE
            default 32

        config NS4168_I2S_DOUT
            int "DOUT GPIO（ESP→NS4168 DIN）"
            depends on NS4168_ENABLE
            default 26

        config NS4168_SAMPLE_RATE
            int "采样率 (Hz)"
            depends on NS4168_ENABLE
            default 16000
            range 8000 48000
    endmenu

    config AUDIO_CAPTURE_DIGITAL_GAIN
        int "采集数字增益倍数"
        default 4
        range 1 16
        help
            audio_capture 读出 PCM 后、扇出前对 int16 放大并饱和。
            与 ES7210 硬件增益叠加。

    config ENV_SOUND_ENABLE
        bool "启用环境声级估算"
        default y
        help
            订阅 ES7210 PCM，用 RMS 估算环境声音（dB），上报到 /api/data 的 sound 字段。

    config ENV_SOUND_REF_DB
        int "全幅对应参考声压 (dB SPL)"
        depends on ENV_SOUND_ENABLE
        default 94
        range 60 130
        help
            level_db ≈ 20*log10(rms/32768) + REF_DB + 传感器 offset_db。
            可用已知声源校准，再通过 Web「校准值」微调。

    config ENV_SOUND_EMA_ALPHA_MILLI
        int "声级平滑系数 (千分比)"
        depends on ENV_SOUND_ENABLE
        default 200
        range 50 900
        help
            EMA: level = (1-a)*prev + a*chunk，200 = 0.2。

endmenu

menu "3. 音频算法 (YAMNet / 唤醒 / 透传)"

    config YAMNET_ENABLE
        bool "启用 YAMNet 声音分类"
        default n
        help
            订阅 audio_capture；模型见 models/yamnet/。

    config YAMNET_VERIFY_ONLY
        bool "仅验证 YAMNet（关 WiFi/传感器/MCP/Web）"
        depends on YAMNET_ENABLE
        default n

    config YAMNET_INFER_MIN_INTERVAL_MS
        int "推理最小间隔 (ms)"
        depends on YAMNET_ENABLE
        range 200 10000
        default 500

    config YAMNET_INFER_HOP_FRAMES
        int "相邻 patch 间隔帧 (10ms/帧)"
        depends on YAMNET_ENABLE
        range 48 96
        default 48

    config YAMNET_INFER_RMS_MIN
        int "静音门限 pcm_rms（0=关闭）"
        depends on YAMNET_ENABLE
        range 0 10000
        default 150

    config YAMNET_EVENT_VOTE_WINDOW
        int "事件投票窗口 N"
        depends on YAMNET_ENABLE
        range 1 16
        default 5

    config YAMNET_EVENT_VOTE_NEED
        int "事件投票最少命中"
        depends on YAMNET_ENABLE
        range 1 16
        default 3

    config YAMNET_EVENT_HOLD_MS
        int "事件告警冷却 (ms)"
        depends on YAMNET_ENABLE
        range 500 60000
        default 4000

    config YAMNET_LOG_VERBOSE
        bool "每次推理打印完整 Top-3"
        depends on YAMNET_ENABLE
        default n

    config YAMNET_INFER_TASK_CORE
        int "推理任务绑核 (-1=不绑)"
        depends on YAMNET_ENABLE
        range -1 1
        default -1

    config YAMNET_DISABLE_ESP_NN
        bool "强制 TFLite reference（仅调试）"
        depends on YAMNET_ENABLE
        default n

    menu "ESP-SR 语音唤醒"
        config ESP_SR_WAKE_ENABLE
            bool "启用"
            depends on YAMNET_ENABLE
            default n
            help
                另在 Component config → ESP Speech Recognition 勾选 WakeNet。

        config ESP_SR_WAKE_START_STREAM
            bool "唤醒后自动 UDP 透传"
            depends on ESP_SR_WAKE_ENABLE && AUDIO_STREAM_ENABLE
            default y

        config ESP_SR_WAKE_FETCH_CORE
            int "AFE fetch 绑核 (-1=不绑)"
            depends on ESP_SR_WAKE_ENABLE
            range -1 1
            default 1
    endmenu

    menu "UDP PCM 透传"
        config AUDIO_STREAM_ENABLE
            bool "启用"
            depends on YAMNET_ENABLE
            default n

        config AUDIO_STREAM_UDP_HOST
            string "目标主机"
            depends on AUDIO_STREAM_ENABLE
            default "192.168.1.100"

        config AUDIO_STREAM_UDP_PORT
            int "目标端口"
            depends on AUDIO_STREAM_ENABLE
            default 9000
            range 1 65535

        config AUDIO_STREAM_MAX_MS
            int "单次最长时长 (ms)"
            depends on AUDIO_STREAM_ENABLE
            default 15000
            range 1000 120000
    endmenu

endmenu

menu "4. 设备事件"

    config DEVICE_EVENT_LOG_SIZE
        int "事件环形缓冲条数"
        default 32
        range 8 128

    config MCP_RADAR_POLL_INTERVAL_MS
        int "毫米波事件轮询 (ms)"
        default 500
        range 200 5000

    config EVENT_RANGE_CONFIRM_MS
        int "进入/离开检测范围确认 (ms)"
        default 1000
        range 500 30000
        help
            软占用（含短暂丢帧容忍）持续该时长后上报 range_enter / range_exit。

    config EVENT_AREA_CONFIRM_MS
        int "进入/离开区域确认 (ms)"
        default 2000
        range 500 30000

    config EVENT_ROOM_EMPTY_MS
        int "探测范围无人确认 (ms)"
        default 300000
        range 5000 1800000

    config EVENT_PERSON_STATIC_MS
        int "人员静止确认 (ms)"
        default 5000
        range 2000 600000

    config EVENT_PERSON_MOVING_CONFIRM_MS
        int "恢复运动确认 (ms)"
        default 1000
        range 500 30000

    config MCP_RADAR_CROSSING_COOLDOWN_MS
        int "room_empty 后抑制重复离开 (ms)"
        default 3000
        range 1000 30000

    config EVENT_ENV_POLL_MS
        int "环境事件轮询 (ms)"
        default 2000
        range 500 30000

    config EVENT_ENV_CONFIRM_MS
        int "环境阈值持续确认 (ms)"
        default 60000
        range 5000 600000

endmenu
