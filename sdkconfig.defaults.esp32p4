# ESP32-P4 无内置 WiFi，必须通过 ESP-Hosted + C6 协处理器
# CONFIG_ESP_HOST_WIFI_ENABLED is not set

CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# 官方 ESP32-P4-Function-EV-Board 请取消下行注释：
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# CONFIG_ESP_HOSTED_ENABLE_ITWT is not set

# ESP-Hosted SDIO 初始化栈较深，默认 3584 不足
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 量产/新板 ESP32-P4 多为 Rev v3.x（与 <3.0 工程样片二进制不兼容）
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y

# YAMNet INT8 推理需要 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ── 1. 板级：I2C0 传感器 + 灯 ──
CONFIG_SENSOR_I2C0_SDA=1
CONFIG_SENSOR_I2C0_SCL=0
CONFIG_LTR303_ENABLE=y
CONFIG_SC7A20H_ENABLE=y
CONFIG_SC7A20H_I2C_ADDR=0x19
CONFIG_WS2812_ENABLE=y
CONFIG_WS2812_GPIO=21
CONFIG_WS2812_LED_COUNT=7

# ── 2. 音频硬件：ES7210(I2C1+I2S0) / NS4168(I2S1) ──
CONFIG_AUDIO_SOURCE_ES7210=y
CONFIG_ES7210_I2C_PORT=1
CONFIG_ES7210_I2C_SDA=7
CONFIG_ES7210_I2C_SCL=8
CONFIG_ES7210_I2C_ADDR=0x40
CONFIG_ES7210_MIC_COUNT=2
CONFIG_ES7210_MIC_GAIN_DB=30
CONFIG_ES7210_I2S_BCLK=29
CONFIG_ES7210_I2S_WS=27
CONFIG_ES7210_I2S_DIN=28
CONFIG_ES7210_I2S_USE_MCLK=y
CONFIG_ES7210_I2S_MCLK=30
CONFIG_AUDIO_CAPTURE_DIGITAL_GAIN=4
CONFIG_NS4168_ENABLE=y
CONFIG_NS4168_I2S_PORT=1
CONFIG_NS4168_I2S_BCLK=33
CONFIG_NS4168_I2S_WS=32
CONFIG_NS4168_I2S_DOUT=26
CONFIG_NS4168_SAMPLE_RATE=16000

# ESP-NN / WDT
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_YAMNET_INFER_MIN_INTERVAL_MS=500
CONFIG_YAMNET_INFER_HOP_FRAMES=48
CONFIG_YAMNET_INFER_RMS_MIN=150
CONFIG_YAMNET_EVENT_VOTE_WINDOW=5
CONFIG_YAMNET_EVENT_VOTE_NEED=3
CONFIG_YAMNET_EVENT_HOLD_MS=4000
# CONFIG_YAMNET_LOG_VERBOSE is not set
CONFIG_YAMNET_INFER_TASK_CORE=-1

# 仅验证 YAMNet 时启用（关闭 WiFi/传感器/MCP/Web）
# CONFIG_YAMNET_ENABLE is not set
# CONFIG_YAMNET_VERIFY_ONLY is not set
# CONFIG_AUDIO_STREAM_ENABLE is not set
# CONFIG_ESP_SR_WAKE_ENABLE is not set
# CONFIG_YAMNET_DISABLE_ESP_NN is not set

# 启用唤醒后请在 menuconfig → ESP Speech Recognition 勾选 WakeNet，
# 并 fullclean + build flash，以便把模型写入 model 分区。

CONFIG_LWIP_SNTP_MAX_SERVERS=3

# ESP-NN Optimized
# CONFIG_NN_ANSI_C is not set
CONFIG_NN_OPTIMIZED=y
CONFIG_NN_OPTIMIZATIONS=1
