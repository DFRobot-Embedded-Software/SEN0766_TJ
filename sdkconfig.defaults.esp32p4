# ESP32-P4 无内置 WiFi，必须通过 ESP-Hosted + C6 协处理器
# CONFIG_ESP_HOST_WIFI_ENABLED is not set

CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# 官方 ESP32-P4-Function-EV-Board 请取消下行注释：
# CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# CONFIG_ESP_HOSTED_ENABLE_ITWT is not set

# ESP-Hosted SDIO 初始化栈较深，默认 3584 不足
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 量产/新板 ESP32-P4 多为 Rev v3.x（与 <3.0 工程样片二进制不兼容）
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y

# YAMNet INT8 推理需要 PSRAM（tensor arena ~1.2MB + 模型缓冲）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ESP-NN Optimized Invoke ~0.55 s；仍关闭 IDLE 检查以免偶发误报
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_YAMNET_INFER_MIN_INTERVAL_MS=500
CONFIG_YAMNET_INFER_HOP_FRAMES=48
CONFIG_YAMNET_INFER_RMS_MIN=150
CONFIG_YAMNET_EVENT_VOTE_WINDOW=5
CONFIG_YAMNET_EVENT_VOTE_NEED=3
CONFIG_YAMNET_EVENT_HOLD_MS=4000
# CONFIG_YAMNET_LOG_VERBOSE is not set
CONFIG_YAMNET_INFER_TASK_CORE=-1

# 仅验证 YAMNet 时启用（关闭 WiFi/传感器/MCP/Web）
CONFIG_YAMNET_ENABLE=y
CONFIG_YAMNET_VERIFY_ONLY=y
CONFIG_YAMNET_ES8388_MIC_GAIN_DB=36
CONFIG_AUDIO_CAPTURE_DIGITAL_GAIN=4
# CONFIG_AUDIO_STREAM_ENABLE is not set
# CONFIG_YAMNET_DISABLE_ESP_NN is not set

# ESP-NN Optimized（P4 加速）。若出现 raw=64 饱和 / Top-3 全 0.750，改回 ANSI：
# CONFIG_NN_ANSI_C=y / # CONFIG_NN_OPTIMIZED is not set
# CONFIG_NN_ANSI_C is not set
CONFIG_NN_OPTIMIZED=y
CONFIG_NN_OPTIMIZATIONS=1
