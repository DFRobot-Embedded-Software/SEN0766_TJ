# 聚合 MCP 监听（爱马仕连 http://127.0.0.1:9080/mcp）
MCP_GW_HOST=0.0.0.0
MCP_GW_PORT=9080

# 广播 _voice-ws / _mcp-gw（mqtt=、ws=）。不填则自动猜局域网 IP
MCP_GW_MDNS=1
# MCP_GW_ADVERTISE_IP=192.168.1.193
MCP_GW_VOICE_WS_PORT=8765
MCP_GW_VOICE_WS_PATH=/ws

# MCP_GW_TOKEN=

# 仅文档保留；枢纽在线状态看 mDNS/MQTT availability，不用此秒数踢掉线
MCP_GW_STALE_S=90
MCP_GW_DEVICE_TIMEOUT_S=15

# 订设备事件。MQTT_HOST 给本进程连 broker（可用 127.0.0.1）。
# 下发给设备的 URI：若 MQTT_HOST 是回环，则改用 MCP_GW_ADVERTISE_IP / 猜到的局域网 IP。
# 固件 topic 前缀写死 mcp_sensors（改 MQTT_PREFIX 无效）。
# 默认按匿名 broker；若 broker 强制登录，再自行加 MQTT_USER / MQTT_PASSWORD。
MQTT_ENABLE=1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_PREFIX=mcp_sensors
MQTT_CLIENT_ID=mcp-sensors-gw
