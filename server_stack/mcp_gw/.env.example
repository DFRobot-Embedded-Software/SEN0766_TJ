# 聚合 MCP 监听（爱马仕连 http://127.0.0.1:9080/mcp）
MCP_GW_HOST=0.0.0.0
MCP_GW_PORT=9080

# mDNS 广播（设备 browse _mcp-gw._tcp）；多网卡时可强制广告 IP
MCP_GW_MDNS=1
MCP_GW_ADVERTISE_IP=192.168.1.27
MCP_GW_REGISTER_PATH=/api/devices/register
MCP_GW_VOICE_WS_PORT=8765
MCP_GW_VOICE_WS_PATH=/ws

# 可选：注册/管理 API 共享密钥（请求头 X-MCP-GW-Token）
# MCP_GW_TOKEN=

# 设备心跳超时（秒），超时后从 tools/list 摘除
MCP_GW_STALE_S=90

# 后台刷新设备工具列表间隔（秒）
MCP_GW_REFRESH_S=30

# 访问设备 MCP 超时（秒）
MCP_GW_DEVICE_TIMEOUT_S=15

# Home Assistant MQTT Discovery（只上报传感器/事件，不上报音频）
# HAOS 上先装 Mosquitto App，再在 MQTT 集成里连 broker；此处填 HA 的局域网 IP。
MQTT_ENABLE=1
MQTT_HOST=192.168.0.219
MQTT_PORT=1883
# Mosquitto App → Configuration → Logins 里新增的账号（HA 自己那组密钥不要拿来给网关）
MQTT_USER=
MQTT_PASSWORD=
MQTT_PREFIX=mcp_sensors
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_POLL_S=15
MQTT_CLIENT_ID=mcp-sensors-gw
