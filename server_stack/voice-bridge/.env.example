# 阿里云 DashScope（ASR/TTS）— 在 https://dashscope.console.aliyun.com/ 创建
DASHSCOPE_API_KEY=

# 爱马仕 API Bearer Token —— 不是去官网申请的！
# 自己在 ~/.hermes/.env 里设一个任意字符串作为 API_SERVER_KEY，然后原样抄到这里。
# 例如：
#   echo 'API_SERVER_KEY=hermes-local-dev' >> ~/.hermes/.env
#   再写：HERMES_API_KEY=hermes-local-dev
# 两者必须完全一致，否则 bridge 调爱马仕会 401。
HERMES_API_KEY=

# 爱马仕 OpenAI 兼容 API（本机 gateway）
HERMES_API_BASE=http://127.0.0.1:8642

