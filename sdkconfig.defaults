# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.4 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32p4"

#
# Bootloader config
#

#
# Application Rollback
#
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# end of Application Rollback
# end of Bootloader config

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# end of Serial flasher config

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions.csv"
# end of Partition Table

#
# 1. 板级总线与传感器
#
CONFIG_SENSOR_I2C0_SDA=46
CONFIG_SENSOR_I2C0_SCL=48

#
# C4004 毫米波雷达 (UART)
#
CONFIG_C4004_UART_TX=11
CONFIG_C4004_UART_RX=12
# end of C4004 毫米波雷达 (UART)
# end of 1. 板级总线与传感器

#
# 2. 音频硬件 (ES7210 / NS4168)
#

#
# ES7210 麦克风 (I2C1 + I2S0 RX)
#
CONFIG_ES7210_I2C_SDA=32
CONFIG_ES7210_I2C_SCL=33
CONFIG_ES7210_I2S_BCLK=28
CONFIG_ES7210_I2S_WS=29
CONFIG_ES7210_I2S_DIN=27
# end of ES7210 麦克风 (I2C1 + I2S0 RX)

#
# NS4168 功放 (I2S1 TX)
#
CONFIG_NS4168_I2S_BCLK=40
CONFIG_NS4168_I2S_WS=41
CONFIG_NS4168_I2S_DOUT=39
CONFIG_NS4168_PLAYBACK_GAIN=1
# end of NS4168 功放 (I2S1 TX)
# end of 2. 音频硬件 (ES7210 / NS4168)

#
# 3. 音频算法 (YAMNet / 唤醒 / 透传)
#
# CONFIG_YAMNET_ENABLE is not set
CONFIG_YAMNET_INFER_RMS_MIN=25

#
# ESP-SR 语音唤醒
#
# CONFIG_ESP_SR_WAKE_ENABLE is not set
# end of ESP-SR 语音唤醒

#
# WebSocket PCM 客户端（连网关）
#
# CONFIG_AUDIO_WS_ENABLE is not set
# end of WebSocket PCM 客户端（连网关）
# end of 3. 音频算法 (YAMNet / 唤醒 / 透传)

#
# ESP Speech Recognition
#

#
# Load Multiple Wake Words (WakeNet9)
#
CONFIG_SR_WN_WN9_HIESP=y
# end of Load Multiple Wake Words (WakeNet9)
# end of ESP Speech Recognition

#
# Component config
#

#
# ESP PSRAM
#
CONFIG_SPIRAM=y

#
# PSRAM config
#
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# end of PSRAM config
# end of ESP PSRAM

#
# ESP System Settings
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# end of ESP System Settings

#
# Log
#

#
# Log Level
#
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# end of Log Level
# end of Log

#
# LWIP
#
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_SNTP_MAX_SERVERS=3

#
# TCP
#
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
# end of TCP
# end of LWIP

#
# ESP-Hosted config
#

#
# Hosted SDIO Configuration
#
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=7
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=3
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=4
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=5
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=1
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=2
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=6
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=3000
# end of Hosted SDIO Configuration

#
# Task defaults
#
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
# end of Task defaults

CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
CONFIG_ESP_HOSTED_ENABLE_ITWT=n
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# end of ESP-Hosted config

#
# ESP WebSocket client
#
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
# end of ESP WebSocket client

#
# Wi-Fi Remote
#

#
# Wi-Fi configuration
#
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=10
CONFIG_WIFI_RMT_RX_BA_WIN=6
# end of Wi-Fi configuration
# end of Wi-Fi Remote
# end of Component config
