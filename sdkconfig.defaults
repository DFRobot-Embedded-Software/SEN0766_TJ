CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions.csv"

# OTA：双槽升级 + 回滚保护（新固件联网成功前不标记为有效，异常时自动回退）
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 全局默认 INFO；Debug 需编译进固件，运行时由 C4004_VERBOSE_LOG 打开毫米波 TAG
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# P4 必须使用 ESP-Hosted，不能开启 Host WiFi
# CONFIG_ESP_HOST_WIFI_ENABLED is not set

# CONFIG_ESP_HOSTED_ENABLE_ITWT is not set
# SDIO 握手失败时不要整机软复位（否则会持续复位环）；WiFi 失败由应用侧重试
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
# 给 C6 更长复位后启动时间，减少 "Not able to connect with slave"
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=3000

# C4004 UART (TX=50, RX=51, 115200)
CONFIG_C4004_UART_PORT=1
CONFIG_C4004_UART_TX=50
CONFIG_C4004_UART_RX=51
CONFIG_C4004_UART_BAUD=115200
CONFIG_C4004_VERBOSE_LOG=y

# C4004：倾角写 zAngle；检测范围默认最大四面边界（侧装约 4m×7m：X±2m / 前方 7m）
CONFIG_C4004_TILT_ANGLE_Z=y
CONFIG_C4004_RANGE_MODE_MAX=y
CONFIG_C4004_RANGE_X_CM=200
CONFIG_C4004_RANGE_Y_POS_CM=700
CONFIG_C4004_RANGE_Y_NEG_CM=0

CONFIG_AUDIO_CAPTURE_DIGITAL_GAIN=4

# NS4168 播放：TTS 偏小，默认 3 倍数字增益（可在 menuconfig 调）
CONFIG_NS4168_PLAYBACK_GAIN=3

# 环境声级：ES7210 PCM RMS → /api/data.sound
CONFIG_ENV_SOUND_ENABLE=y
CONFIG_ENV_SOUND_REF_DB=94
CONFIG_ENV_SOUND_EMA_ALPHA_MILLI=200

# 本地局域网 MCP，无需 OAuth（避免 Hermes 等客户端误走 OAuth 发现流程）
CONFIG_MCP_HTTP_OAUTH_METADATA_ENABLE=n
# Hermes 等客户端可能发 OPTIONS 预检；SDK 仅在开启 CORS 时注册 OPTIONS handler
CONFIG_MCP_HTTP_CORS_ENABLE=y

# WebSocket 收发分锁：下行时若仍持共享锁 send，会堵死读并 abort 连接
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000

# ---- PSRAM：缓解播放+网页+MCP 并发时 internal 耗尽（SDIO RX alloc failed）----
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
# ≤4KB 仍优先 internal（小对象/DMA 友好）；更大块走 PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
